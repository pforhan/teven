# Whether to pre-populate data
DEV_MODE=false

# PostgreSQL Database Settings
TEVEN_POSTGRES_DB=teven_db
TEVEN_POSTGRES_USER=teven_user
TEVEN_POSTGRES_PASSWORD=teven_password

# Backend Application Port
# The external port your machine will use to access the backend.
TEVEN_BACKEND_PORT=2022

# Super Admin User - used to seed the database with an initial admin account
SUPERADMIN_EMAIL=admin@teven.com
SUPERADMIN_PASSWORD=super_secret_password

# JWT Configuration
# This is a default value and should be changed for production deployments
JWT_SECRET=your_jwt_secret_key_here
JWT_ISSUER=teven-issuer
JWT_AUDIENCE=teven-audience
# logged in sessions are 24 hours
JWT_EXPIRATION_MILLIS=86400000

# Geographic Services
# Choose between: MOCK, MAPBOX, RADAR
GEO_PROVIDER=MOCK
GEO_API_KEY=your_geo_api_key_here

# Number of days until the map marker color remains "pure green"
GEO_COLOR_SCALE_LIMIT_DAYS=14

# TEMPORARY (Flutter conversion, Phases 0-10) - safe to delete after cutover.
#
# Which web frontend to compile into the backend image:
#   react   - the current React SPA in frontend/ (default, and the live app)
#   flutter - the Flutter rewrite in flutter_app/
#
# Build-time only; not used at runtime. Both pipelines stay buildable during the
# migration, and the unselected one is never built, so switching costs a full
# rebuild of the other frontend. Use with:
#   WEB_SOURCE=flutter docker compose up --build
#
# Task 10.1 of FLUTTER-CONVERT.md flips the default to `flutter`; task 10.3 then
# deletes frontend/ and this entry goes with it.
WEB_SOURCE=react