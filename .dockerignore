# Docker build context filter.
#
# The repo is ~589 MB unfiltered, mostly build tooling that the Dockerfile never
# COPYs. Excluding it keeps `docker build` fast and avoids shipping host-specific
# artifacts into the image.

.git
.gitignore
**/.DS_Store
.idea
**/*.iml

# Node / React: `npm install` runs inside the image.
frontend/node_modules
frontend/dist

# Dart / Flutter build tooling.
#
# NOTE: flutter_app/build/web is deliberately NOT excluded. The Flutter variant
# copies a prebuilt bundle from there (task 0.12) instead of building in Docker.
# Everything else under build/ is regenerated by `flutter pub get` or the build.
flutter_app/.dart_tool
flutter_app/build/*
!flutter_app/build/web
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages

# Gradle / JVM
.gradle
**/build/classes
**/build/libs
backend/*/build
backend/*/*/build

# Local env and editor config
.env
*.log