#!/usr/bin/env bash
#
# teven — task runner for the Teven stack.
#
# Wraps the Docker Compose workflow so the Flutter prebuild step can't be
# forgotten. `up` always rebuilds the web bundle before packaging, which removes
# the silent-staleness failure mode of calling `docker compose up --build`
# directly.
#
# POSIX-ish bash; avoids bash 4+ features so it runs on the macOS system bash.
# Run `./teven help` for available commands.

set -euo pipefail

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly FLUTTER_DIR="${ROOT}/flutter_app"

# Host port the backend publishes, and how long we wait for it to answer before
# giving up on the `--open` handshake. The port must match docker-compose.yml's
# ${TEVEN_BACKEND_PORT:-2022}; resolved via app_port so an override in the
# environment or .env is honored rather than hardcoded.
readonly APP_READY_TIMEOUT=120

# Build flags for the host-side Flutter build. --no-web-resources-cdn self-hosts
# CanvasKit, removing a third-party runtime fetch (FLUTTER-CONVERT.md task 0.10).
readonly FLUTTER_BUILD_ARGS=(
  build
  web
  --release
  --no-web-resources-cdn
)

die() {
  printf 'teven: %s\n' "$1" >&2
  exit "${2:-1}"
}

# Print a command's leading words without executing it, for dry-run support.
show() {
  printf '  $ %s\n' "$*"
}

run() {
  show "$@"
  "$@"
}

need() {
  command -v "$1" >/dev/null 2>&1 ||
    die "'$1' not found on PATH. ${2:-}"
}

# The host port the backend is published on. Docker Compose resolves
# ${TEVEN_BACKEND_PORT:-2022} from the environment first and the repo .env
# second, so mirror that order rather than hardcoding 2022.
app_port() {
  local port="${TEVEN_BACKEND_PORT:-}"
  if [ -z "$port" ] && [ -f "${ROOT}/.env" ]; then
    port="$(sed -n \
      's/^[[:space:]]*TEVEN_BACKEND_PORT[[:space:]]*=[[:space:]]*\([^[:space:]#]*\).*/\1/p' \
      "${ROOT}/.env" | tail -n 1)"
  fi
  printf '%s' "${port:-2022}"
}

# Block until the backend answers on the given URL. Any HTTP response counts,
# including a redirect or a TLS error page — the point is that the port is
# bound, not that the app is fully warmed. The self-signed dev cert means -k.
wait_for_app() {
  local url="$1" waited=0
  printf '==> Waiting for %s\n' "$url"
  while [ "$waited" -lt "$APP_READY_TIMEOUT" ]; do
    if curl -k -sS -o /dev/null --max-time 5 "$url" 2>/dev/null; then
      printf '    Ready.\n'
      return 0
    fi
    sleep 2
    waited=$((waited + 2))
  done
  printf '    No response after %ss; opening anyway.\n' "$APP_READY_TIMEOUT" >&2
  return 1
}

open_browser() {
  local url="$1"
  if command -v open >/dev/null 2>&1; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
  elif command -v wslview >/dev/null 2>&1; then
    wslview "$url"
  else
    printf '    No browser opener on PATH; open %s yourself.\n' "$url"
  fi
}

usage() {
  cat <<'EOF'
teven — task runner for the Teven stack

Usage: ./teven <command> [options]

Commands:
  up                 Build the Flutter web bundle, then start the stack
                     in the background (docker compose -d).
  up -f | --foreground
                     Same, but stream logs in the foreground instead.
  up -o | --open     Same, but wait for the backend to answer, then open the
                     app in the default browser.
  up-react           Start the stack with the React frontend. No prebuild
                     needed: React builds inside Docker. Takes -f and -o too.
  build              Build the Flutter web bundle only, no Docker.
  dev                Run the Flutter app against a local backend
                     (flutter run -d chrome).
  verify             Analyze, format-check, and test the Flutter app.
  clean              Remove built web bundles (Flutter and React).
  down               Stop the containers.
  down -v | --volumes
                     Stop containers and delete volumes (drops the DB).
  status             Show container status.
  logs               Tail container logs.
  help               Show this help. Default when no command is given.

Options:
  -f, --foreground   Stream logs instead of detaching (for `up`).
  -o, --open         Open the app in the default browser once the backend
                     answers (for `up` and `up-react`). Ignored with -f,
                     which never returns to the prompt to do it.
  -v, --volumes      Also delete volumes (for `down`).
  -n, --dry-run      Print the commands that would run, without running them.
  -h, --help         Show this help.

Environment:
  WEB_SOURCE         Which frontend to package: react | flutter.
                     `up` forces flutter; `up-react` forces react.
                     (Default: flutter.)

Examples:
  ./teven up                    # build Flutter, then start in background
  ./teven up -f                 # build Flutter, then stream logs
  ./teven up --open             # start, wait, then open the browser
  ./teven up --dry-run          # show what would run
  ./teven up-react              # start with the React frontend
  ./teven verify                # analyze + format check + test
  ./teven down -v               # full reset, including the database
EOF
}

main() {
  local command="${1:-help}"
  shift || true

  local foreground=0 volumes=0 dry_run=0 open_app=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -f | --foreground) foreground=1 ;;
      -o | --open) open_app=1 ;;
      -v | --volumes) volumes=1 ;;
      -n | --dry-run) dry_run=1 ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        printf 'teven: unknown option: %s\n\n' "$1" >&2
        usage >&2
        return 2
        ;;
    esac
    shift
  done

  case "$command" in
    up) cmd_up "$foreground" "$dry_run" "$open_app" ;;
    up-react) cmd_up_react "$foreground" "$dry_run" "$open_app" ;;
    build) cmd_build "$dry_run" ;;
    dev) cmd_dev "$dry_run" ;;
    verify) cmd_verify "$dry_run" ;;
    clean) cmd_clean "$dry_run" ;;
    down) cmd_down "$volumes" "$dry_run" ;;
    status) cmd_simple status "$dry_run" ;;
    logs) cmd_simple logs "$dry_run" ;;
    help) usage ;;
    *)
      printf 'teven: unknown command: %s\n\n' "$command" >&2
      usage >&2
      return 2
      ;;
  esac
}

# Build the Flutter web bundle. This must run before any `flutter` compose
# build, because the Dockerfile copies flutter_app/build/web rather than
# building it (FLUTTER-CONVERT.md task 0.12: Flutter publishes no linux/arm64
# SDK, so building in Docker means amd64 emulation).
cmd_build() {
  local dry_run="$1"
  need flutter "Install the Flutter SDK, or use ./teven up-react." || return 1
  printf '==> Building Flutter web bundle\n'
  if [ "$dry_run" -eq 1 ]; then
    (cd "$FLUTTER_DIR" && show flutter "${FLUTTER_BUILD_ARGS[@]}")
  else
    (cd "$FLUTTER_DIR" && flutter "${FLUTTER_BUILD_ARGS[@]}")
  fi
}

# After the stack is up: wait for the backend, then open it. No-op when -o
# wasn't passed, or when the logs are streaming in the foreground -- in that
# mode we never return to the prompt, so there is nowhere to put the browser.
maybe_open() {
  local open_app="$1" foreground="$2" dry_run="$3"
  local url="https://localhost:$(app_port)"

  if [ "$open_app" -eq 0 ]; then
    printf '\n==> App: %s\n' "$url"
    return 0
  fi
  if [ "$foreground" -eq 1 ]; then
    printf '\n==> App: %s\n' "$url"
    printf '    Not opening: --open needs the background mode to wait in.\n'
    return 0
  fi

  if [ "$dry_run" -eq 1 ]; then
    printf '\n==> App: %s\n' "$url"
    show curl --insecure --silent --show-error --output /dev/null "$url"
    show open "$url"
    return 0
  fi

  # A failed wait is a warning, not an error: the containers did come up, and
  # the browser is the whole point of --open even if the probe timed out.
  wait_for_app "$url" || true
  printf '==> Opening %s\n' "$url"
  open_browser "$url"
}

cmd_up() {
  local foreground="$1" dry_run="$2" open_app="$3"
  cmd_build "$dry_run" || return 1
  printf '==> Starting the stack (frontend: flutter)\n'
  local -a compose=(docker compose up --build)
  [ "$foreground" -eq 1 ] || compose+=(-d)
  if [ "$dry_run" -eq 1 ]; then
    show "${compose[@]}"
  else
    WEB_SOURCE=flutter "${compose[@]}"
  fi
  maybe_open "$open_app" "$foreground" "$dry_run"
}

cmd_up_react() {
  local foreground="$1" dry_run="$2" open_app="$3"
  printf '==> Starting the stack (frontend: react)\n'
  printf '    React builds inside Docker; no prebuild step needed.\n'
  local -a compose=(docker compose up --build)
  [ "$foreground" -eq 1 ] || compose+=(-d)
  if [ "$dry_run" -eq 1 ]; then
    show "${compose[@]}"
  else
    WEB_SOURCE=react "${compose[@]}"
  fi
  maybe_open "$open_app" "$foreground" "$dry_run"
}

# The web dev server origin the backend's dev CORS allows. Kept here and in
# Application.kt (devCorsPorts); if you change one, change the other.
readonly DEV_WEB_PORT=3000

cmd_dev() {
  local dry_run="$1"
  need flutter "Install the Flutter SDK first." || return 1
  printf '==> Running the Flutter app against http://localhost:2022\n'
  printf '    Serving on http://localhost:%s\n' "$DEV_WEB_PORT"
  printf '    The backend must already be running with DEV_MODE=true (./teven up).\n'
  printf '\n'
  printf '    Hot reload is live. Press "q" to quit.\n'
  printf '\n'
  # API_BASE_URL is required here, not optional. The app uses relative URLs on
  # web by default, which resolve against whatever origin served the page -- so
  # without this, `flutter run` calls its own dev server for /api and gets a
  # 404 instead of reaching the backend. The dev server picks a random port
  # otherwise, which the backend's CORS allow-list cannot name, hence
  # --web-port.
  local -a dev_cmd=(
    run
    -d
    chrome
    --web-port="$DEV_WEB_PORT"
    --dart-define=API_BASE_URL=http://localhost:2022
  )
  if [ "$dry_run" -eq 1 ]; then
    (cd "$FLUTTER_DIR" && show flutter "${dev_cmd[@]}")
  else
    (cd "$FLUTTER_DIR" && flutter "${dev_cmd[@]}")
  fi
}

cmd_verify() {
  local dry_run="$1"
  need flutter "Install the Flutter SDK first." || return 1
  printf '==> Verifying the Flutter app\n'
  if [ "$dry_run" -eq 1 ]; then
    (cd "$FLUTTER_DIR" && show flutter analyze && show dart format --output=none --set-exit-if-changed . && show flutter test)
  else
    (
      cd "$FLUTTER_DIR" &&
        flutter analyze &&
        dart format --output=none --set-exit-if-changed . &&
        flutter test
    )
  fi
}

cmd_clean() {
  local dry_run="$1"
  printf '==> Removing built web bundles\n'
  local target
  for target in "${FLUTTER_DIR}/build/web" "${ROOT}/frontend/dist"; do
    if [ -e "$target" ]; then
      printf '  - %s\n' "${target#"${ROOT}"/}"
      [ "$dry_run" -eq 1 ] || rm -rf "$target"
    fi
  done
}

cmd_down() {
  local volumes="$1" dry_run="$2"
  local -a compose=(docker compose down)
  [ "$volumes" -eq 1 ] && compose+=(-v)
  if [ "$dry_run" -eq 1 ]; then
    show "${compose[@]}"
  else
    "${compose[@]}"
  fi
}

cmd_simple() {
  local sub="$1" dry_run="$2"
  if [ "$dry_run" -eq 1 ]; then
    show docker compose "$sub"
  else
    docker compose "$sub"
  fi
}

main "$@"